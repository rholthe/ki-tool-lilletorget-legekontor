# ─────────────────────────────────────────────────────────────────────────────
# legeassist – miljøvariabler (mal). Kopier til .env og fyll inn hemmelighetene.
#   cp .env.example .env
# .env er gitignored og skal ALDRI committes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MariaDB) ──
# Samme MariaDB som i dev (i dev nås den via SSH-tunnel; på serveren er den lokal).
# Format: mysql://bruker:passord@host:3306/databasenavn
DATABASE_URL="mysql://legeassist:PASSORD@localhost:3306/legeassist"

# ── NextAuth v5 ──
# Generer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Må være true bak reverse proxy (Apache) for korrekt host-deteksjon
AUTH_TRUST_HOST=true

# ── 2FA / TOTP-kryptering (32 bytes = 64 hex-tegn) ──
# Generer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# ── Soniox (kun server-side; genererer kortlivede tokens til nettleseren) ──
SONIOX_API_KEY=
# EU-endepunkter for GDPR
SONIOX_API_HOST=https://api.eu.soniox.com
SONIOX_WS_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket

# ── Claude via AWS Bedrock ──
# IAM-bruker med Bedrock-tilgang (ikke root)
BEDROCK_API_KEY=
BEDROCK_SECRET_KEY=
# Modell og region (eu.-prefiks => cross-region inference innenfor EU)
ANTHROPIC_MODEL=eu.anthropic.claude-sonnet-4-6
AWS_REGION=eu-central-1
# Valg som vises på admin-innstillingssiden (kommaseparert)
BEDROCK_MODELS=eu.anthropic.claude-sonnet-4-6,eu.anthropic.claude-opus-4-8
BEDROCK_REGIONS=eu-central-1,eu-west-1

# ── Administrasjon ──
# Kommaseparert liste over admin-e-poster
ADMIN_EMAILS=ragnar@lilletorget.org

# ── E-post (SMTP) – Google Workspace med app-passord ──
# App-passord lages i Google-konto → Sikkerhet → App-passord (krever 2FA på kontoen)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ragnar@lilletorget.org
SMTP_PASSWORD=
SMTP_FROM="LegeAssist <ragnar@lilletorget.org>"
# Mottaker for tilgangsforespørsler (faller tilbake til SMTP_USER hvis tom)
ACCESS_REQUEST_TO=ragnar@lilletorget.org

# ── App ──
# Offentlig basis-URL – brukes til absolutte lenker i e-post (invitasjon m.m.)
APP_URL=https://ki.lilletorget.org
# Porten pm2/next start lytter på (3000 er opptatt av en annen app)
PORT=3001
