# ─────────────────────────────────────────────────────────────────────────────
# legeassist – miljøvariabler (mal). Kopier til .env og fyll inn verdiene.
#   cp .env.example .env
# .env er gitignored og skal ALDRI committes.
# Alle nøklene under leses av appen. Eksempelverdiene (eksempel.no) må byttes ut.
# Se README.md («Installere på egen server») for hvordan kontoene settes opp.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MariaDB 10.11+ eller MySQL 8) ──
# Format: mysql://bruker:passord@host:3306/databasenavn
# Med docker-compose og en MariaDB-container på samme Docker-nettverk er host
# containernavnet (f.eks. shared-mariadb). Spesialtegn i passordet må URL-kodes.
DATABASE_URL="mysql://legeassist:PASSORD@shared-mariadb:3306/legeassist"

# ── NextAuth v5 ──
# Generer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Må være true bak reverse proxy (Caddy/nginx) for korrekt host-deteksjon
AUTH_TRUST_HOST=true
# Kanonisk base-URL (prod). Hindrer redirects til localhost bak proxy.
# Fjern linjen i lokal utvikling.
AUTH_URL=https://legeassist.eksempel.no

# ── Kryptering av TOTP-hemmeligheter og brukernes datanøkler (32 bytes = 64 hex-tegn) ──
# Generer som AUTH_SECRET. IKKE bytt etter at brukere har aktivert 2FA — da
# må alle sette opp to-faktor og nøkler på nytt.
TOTP_ENCRYPTION_KEY=

# ── Soniox (sanntidstranskripsjon) ──
# API-nøkkel fra console.soniox.com. Brukes kun på serveren til å lage kortlivede tokens.
# EU-endepunktene krever et EU-prosjekt hos Soniox.
SONIOX_API_KEY=
SONIOX_API_HOST=https://api.eu.soniox.com
SONIOX_WS_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket

# ── Claude via AWS Bedrock ──
# Tilgangsnøkkel for en egen IAM-bruker (ikke root). Brukeren trenger:
#   - bedrock:InvokeModel og bedrock:InvokeModelWithResponseStream på Anthropic-modellene i EU
#   - sts:GetFederationToken på arn:aws:sts::<KONTO-ID>:federated-user/la-*
# Se README.md for ferdig IAM-policy. Nøklene forlater aldri serveren.
BEDROCK_API_KEY=
BEDROCK_SECRET_KEY=
# Standardmodell og -region (eu.-prefiks = cross-region inference innenfor EU).
# Kan endres senere på /admin/innstillinger.
ANTHROPIC_MODEL=eu.anthropic.claude-sonnet-4-6
AWS_REGION=eu-central-1
# Valgene som vises på admin-innstillingssiden (kommaseparert)
BEDROCK_MODELS=eu.anthropic.claude-sonnet-4-6,eu.anthropic.claude-opus-4-8
BEDROCK_REGIONS=eu-central-1,eu-west-1

# ── Helsedirektoratets API (retningslinjer, pakkeforløp; NLOD) ──
# Produksjonsnøkkel fra utvikler.helsedirektoratet.no (ikke QA — QA har utdaterte doser).
# Uten nøkkel virker resten av appen, men retningslinjer og pakkeforløp kan ikke hentes.
HELSEDIR_API_KEY=

# ── Administrasjon ──
# Kommaseparert liste over e-poster som er administratorer
ADMIN_EMAILS=admin@eksempel.no

# ── E-post (SMTP) – invitasjoner, glemt passord, tilgangsforespørsler ──
# Port 587 = STARTTLS, 465 = implisitt TLS. Bruk vertsnavnet sertifikatet gjelder for.
SMTP_HOST=smtp.eksempel.no
SMTP_PORT=587
SMTP_USER=legeassist@eksempel.no
SMTP_PASSWORD=
# Valgfri; faller tilbake til SMTP_USER
SMTP_FROM="LegeAssist <legeassist@eksempel.no>"
# Mottaker for tilgangsforespørsler fra /tilgang (faller tilbake til SMTP_USER)
ACCESS_REQUEST_TO=admin@eksempel.no

# ── App ──
# Offentlig basis-URL: lenker i e-post, og domenet passkeys knyttes til
APP_URL=https://legeassist.eksempel.no
# Porten appen lytter på i containeren (reverse proxy peker hit)
PORT=3001
