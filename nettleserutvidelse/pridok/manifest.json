{
  "manifest_version": 3,
  "name": "LegeAssist → Pridok",
  "version": "1.2.0",
  "description": "Sender journalnotat og skjema fra LegeAssist til et åpent dokument i Pridok, og henter navn, fødselsnummer og adresse for pasienten som er åpen. Alt går bare mellom fanene i nettleseren.",
  "icons": {
    "16": "ikoner/ikon-16.png",
    "32": "ikoner/ikon-32.png",
    "48": "ikoner/ikon-48.png",
    "96": "ikoner/ikon-96.png",
    "128": "ikoner/ikon-128.png"
  },
  "background": {
    "service_worker": "bakgrunn.js",
    "scripts": [
      "bakgrunn.js"
    ]
  },
  "host_permissions": [
    "https://epj3.pridok.no/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ki.lilletorget.org/*",
        "http://localhost/*"
      ],
      "js": [
        "legeassist.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://epj3.pridok.no/*"
      ],
      "js": [
        "pridok.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "legeassist-pridok@lilletorget.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
