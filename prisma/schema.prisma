generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── NextAuth v5 required tables ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // AES-256-GCM kryptert TOTP-hemmelighet

  // Databehandleravtale: signeres av brukeren (behandlingsansvarlig).
  // Ingen appbruk uten gyldig signatur på gjeldende versjon.
  dpaSignedAt DateTime?
  dpaVersion  String?

  // Nøkkel som krypterer brukerens konsultasjoner i nettleseren (IndexedDB).
  // Lagres kryptert med serverens hovednøkkel; utleveres kun til innlogget bruker
  // og holdes bare i minnet i nettleseren. Utlogget = dataene er låst.
  datanokkel String? @db.Text

  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  maler          Mal[]
  meldingerLest  MeldingLest[]

  passordOppsett PasswordSetupToken?
  gjenopprettingskoder Gjenopprettingskode[]
  passkeys             Passkey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Engangstoken for at en ny bruker selv setter passord (invitasjon).
// Token sendes som klartekst i e-postlenke; kun SHA-256-hash lagres.
model PasswordSetupToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Engangskoder for innlogging når telefonen med autentiseringsappen er borte.
// Ti per bruker, laget når to-faktor aktiveres. Bare HMAC (med serverens
// nøkkel) lagres; klarteksten vises én gang. `bruktAt` settes ved bruk.
model Gjenopprettingskode {
  id        String    @id @default(cuid())
  userId    String
  kodeHash  String    @unique @db.VarChar(64)
  bruktAt   DateTime?
  opprettet DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Passkey (WebAuthn): innlogging uten passord og engangskode. Krever
// brukerverifisering (biometri/PIN), så én passkey er fullverdig tofaktor.
// Kan bare legges til når TOTP er aktivert, og slettes sammen med TOTP.
// Bare den offentlige nøkkelen lagres.
model Passkey {
  id                String    @id @default(cuid())
  userId            String
  credentialId      String    @unique @db.VarChar(512) // base64url
  publicKey         String    @db.Text // base64url, COSE
  counter           Int       @default(0)
  transports        String?   @db.VarChar(255) // kommaseparert
  // Kan synkroniseres mellom enheter (Bitwarden, iCloud, Google) — ellers bundet
  // til én enhet (YubiKey, som regel Windows Hello)
  flerEnhet         Boolean   @default(false)
  sikkerhetskopiert Boolean   @default(false)
  aaguid            String?   @db.VarChar(36)
  navn              String    @db.VarChar(100)
  opprettet         DateTime  @default(now())
  sistBrukt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Engangsutfordring (challenge) for registrering eller innlogging med passkey.
// Slettes når den brukes; utløpte rader ryddes ved neste opprettelse.
model PasskeyUtfordring {
  id         String   @id @default(cuid())
  utfordring String   @db.VarChar(128)
  formaal    String   @db.VarChar(20) // "registrering" | "innlogging"
  userId     String? // satt ved registrering
  utloper    DateTime

  @@index([utloper])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// WebAuthn / YubiKey (FIDO2 passkeys)
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String  @db.Text
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ─── App-modeller ─────────────────────────────────────────────────────────────

enum MalKategori {
  KONSULTASJON
  MOTE
  CHAT
  DIKTAT
  AIHJELP
}

model Mal {
  id          String      @id @default(cuid())
  tittel      String
  beskrivelse String?
  innhold     String      @db.Text
  kategori    MalKategori

  erPrivat Boolean @default(true)
  erDelt   Boolean @default(false)

  eierBrukerId String
  eier         User   @relation(fields: [eierBrukerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eierBrukerId])
  @@index([kategori])
  @@index([erDelt])
}

// `value` er TEXT, ikke standard VARCHAR(191): staging-prompter, priser (JSON) og
// utvalg av retningslinjer (JSON med id-er) er langt lengre enn 191 tegn
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Versjonert databehandleravtale. Opprettes av admin; gamle versjoner er
// uforanderlige (ingen redigering). `gjeldende` markerer den aktive versjonen.
// `krevNySignering` = betydelig endring → alle må signere på nytt.
model DpaVersjon {
  id              String   @id @default(cuid())
  versjon         String   @unique // f.eks. "1.0", "2.0"
  innhold         String   @db.Text // avtaletekst (markdown)
  krevNySignering Boolean  @default(true)
  gjeldende       Boolean  @default(false)
  opprettetAv     String? // e-post til admin som opprettet versjonen
  publisertAt     DateTime @default(now())

  @@index([gjeldende])
}

// Meldinger fra admin til alle brukere (f.eks. nye sikkerhetsrutiner). Vises
// som en modal øverst i appen til brukeren aktivt har trykket «lest».
// `aktiv = false` trekker meldingen tilbake (vises ikke lenger, lesestatus beholdes).
model Melding {
  id          String        @id @default(cuid())
  tittel      String        @db.VarChar(200)
  innhold     String        @db.Text // markdown
  aktiv       Boolean       @default(true)
  opprettetAv String? // e-post til admin som opprettet meldingen
  publisertAt DateTime      @default(now())
  lest        MeldingLest[]

  @@index([aktiv, publisertAt])
}

model MeldingLest {
  meldingId String
  userId    String
  lestAt    DateTime @default(now())

  melding Melding @relation(fields: [meldingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meldingId, userId])
  @@index([userId])
}

// Bruksstatistikk: én rad per AI-kall eller opptaksøkt. Kun tall — aldri
// innhold. Rapporteres av nettleseren etter hvert kall (Bedrock og Soniox
// kalles direkte derfra). Kostnaden regnes ut på serveren med prisene som
// gjaldt da raden ble skrevet. Ingen fremmednøkkel: statistikken skal bestå
// også etter at en bruker er slettet.
model Bruk {
  id               String   @id @default(cuid())
  userId           String
  tjeneste         String   @db.VarChar(20) // BEDROCK | SONIOX
  funksjon         String   @db.VarChar(40) // notat, chat, aihjelp, promptbygger, transkribering, diktering
  modell           String?  @db.VarChar(120)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheLesTokens   Int      @default(0)
  cacheSkrivTokens Int      @default(0)
  lydMs            Int      @default(0)
  antallTegn       Int      @default(0)
  kostnadUsd       Decimal  @default(0) @db.Decimal(12, 6)
  opprettet        DateTime @default(now())

  @@index([userId, opprettet])
  @@index([opprettet])
}

// Mellomlager for innhold hentet fra Helsedirektoratets API (HAPI). Offentlig
// innhold under NLOD — aldri pasientdata. Én rad per kilde (f.eks. antibiotika-
// retningslinjen), lagret ferdig oversatt. `format` er versjonen av
// oversettingen: endres den, bygges raden på nytt ved neste henting.
model HapiInnhold {
  id                  String    @id @db.VarChar(80)
  data                String    @db.LongText
  format              Int
  sistFagligOppdatert DateTime?
  hentetAt            DateTime
  // Siste feilmelding ved henting (uten innhold), null når siste henting gikk bra
  sisteFeil           String?   @db.VarChar(500)
  sisteForsokAt       DateTime?
}
